<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.CleanupLocalBranches"
             x:DataType="vm:CleanupLocalBranches">
  <StackPanel Orientation="Vertical" Margin="8,0">
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16"
            Data="{StaticResource Icons.Clean}"/>

      <TextBlock FontSize="18"
                 Margin="8,0,0,0"
                 Classes="bold"
                 Text="{DynamicResource Text.CleanupLocalBranches}"/>
    </StackPanel>

    <TextBlock Margin="4,16,0,0"
               Text="{DynamicResource Text.CleanupLocalBranches.Tip}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Brush.FG2}"
               FontStyle="Italic" />

    <CheckBox Margin="4,8,0,0"
              Content="{DynamicResource Text.CleanupLocalBranches.IncludeUnpushed}"
              IsChecked="{Binding IncludeUnpushed, Mode=TwoWay}"/>

    <Border Margin="4,8,0,0"
            Height="32"
            Background="{DynamicResource Brush.Contents}"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border1}"
            CornerRadius="4"
            IsVisible="{Binding !HasCandidates}">
      <TextBlock HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.FG2}"
                 Text="{DynamicResource Text.CleanupLocalBranches.Empty}"/>
    </Border>

    <Border Margin="4,8,0,0"
            Background="{DynamicResource Brush.Contents}"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border1}"
            CornerRadius="4"
            Padding="4"
            IsVisible="{Binding HasCandidates}">
      <ListBox MaxHeight="240"
               BorderThickness="0"
               Background="Transparent"
               ItemsSource="{Binding Candidates}"
               SelectionMode="Single"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="4"/>

            <Setter Property="FocusAdorner">
              <FocusAdornerTemplate>
                <Border/>
              </FocusAdornerTemplate>
            </Setter>
          </Style>
        </ListBox.Styles>

        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Vertical"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:CleanupLocalBranchItem">
            <Grid Height="26" ColumnDefinitions="Auto,22,*,Auto">
              <CheckBox Grid.Column="0" Margin="4,0,0,0" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
              <Path Grid.Column="1" Width="10" Height="10" Margin="4,0,8,0" Data="{StaticResource Icons.Branch}" />
              <TextBlock Grid.Column="2" Text="{Binding Branch.Name}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                <TextBlock Foreground="{DynamicResource Brush.FG2}"
                           Text="{DynamicResource Text.CleanupLocalBranches.UpstreamGone}"
                           IsVisible="{Binding IsUpstreamGone}"/>
                <TextBlock Foreground="{DynamicResource Brush.FG2}"
                           Text="{DynamicResource Text.CleanupLocalBranches.NoUpstream}"
                           IsVisible="{Binding !IsUpstreamGone}"/>
                <TextBlock Margin="8,0,0,0"
                           Foreground="OrangeRed"
                           Text="{DynamicResource Text.CleanupLocalBranches.Unmerged}"
                           IsVisible="{Binding !IsMerged}"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <StackPanel Margin="4,4,0,0" Orientation="Horizontal" IsVisible="{Binding HasCandidates}">
      <Button Classes="flat"
              Height="24"
              Padding="8,0"
              Content="{DynamicResource Text.CleanupLocalBranches.SelectAll}"
              Command="{Binding SelectAll}"/>
      <Button Classes="flat"
              Height="24"
              Margin="8,0,0,0"
              Padding="8,0"
              Content="{DynamicResource Text.CleanupLocalBranches.UnselectAll}"
              Command="{Binding UnselectAll}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
